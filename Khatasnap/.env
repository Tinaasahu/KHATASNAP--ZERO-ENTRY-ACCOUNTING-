# ─── KhataSnap Unified Configuration ─────────────────────────────
# All services read from this single file.

# Service Ports
ORCHESTRATOR_PORT=8000
OCR_SERVICE_PORT=8001
VOICE_SERVICE_PORT=8002
SRE_SERVICE_PORT=8003
INVENTORY_SERVICE_PORT=8004
FRONTEND_PORT=3000

# Service URLs (used by orchestrator to call downstream services)
OCR_SERVICE_URL=http://127.0.0.1:8001
VOICE_SERVICE_URL=http://127.0.0.1:8002
SRE_SERVICE_URL=http://127.0.0.1:8003
INVENTORY_SERVICE_URL=http://127.0.0.1:8004

# Database
DB_PATH=khatasnap.db

# OCR Pipeline
OLLAMA_HOST=http://127.0.0.1:11434
VLM_MODEL=glm-ocr

# Logging
LOG_LEVEL=INFO
